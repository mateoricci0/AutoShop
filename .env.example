# ============================================================
# ASE — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env or .env.local to version control.
# ============================================================

# === INFRASTRUCTURE ===
DATABASE_URL=postgresql+asyncpg://ase_app:ase_dev_password@postgres:5432/ase
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=ase_dev_password
ENVIRONMENT=development
LOG_LEVEL=INFO

# === AUTH (generated by scripts/generate-keys.sh) ===
FERNET_KEY=
ADMIN_PASSWORD_HASH=
SECRET_KEY=
SESSION_TTL_SECONDS=2592000

# === AI MODELS ===
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PRIMARY=deepseek
LLM_PREMIUM=openai

# === SCRAPING ===
APIFY_API_KEY=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# === IMAGE GENERATION ===
STABILITY_API_KEY=

# === STORAGE (MinIO / S3) ===
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ase-images

# === SHOPIFY ===
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=

# === NOTIFICATIONS ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DISCORD_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK=

# === MONITORING ===
GRAFANA_PASSWORD=admin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
